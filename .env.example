# Optional. The app works without this.
OPENAI_API_KEY=

# Optional model used only to polish rule-based wording.
OPENAI_MODEL=gpt-4o-mini

# App URL for sitemap and Stripe redirect URLs.
APP_BASE_URL=http://localhost:8000

# Premium Pack payments are disabled unless all of these are set.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional Supabase Auth. Without these, login is disabled and all users are Free.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only. Used by Stripe fulfilment to update profile plan/status.
SUPABASE_SERVICE_ROLE_KEY=

# Optional MVP-only lead admin password.
ADMIN_PASSWORD=

# Optional approved supplier affiliate/tracked links.
# Add only real approved HTTPS URLs from an affiliate network, supplier programme,
# referral agreement or tracked-link provider. Missing or malformed values fall
# back to normal editorial supplier URLs.
# Majestic/Awin rejected ClientCellar on 2026-08-21 because the advertiser
# does not work with this publisher type. Keep Majestic editorial-only until
# a later reapplication is approved.
CLIENTCELLAR_AFFILIATE_URL_LAITHWAITES=
CLIENTCELLAR_AFFILIATE_URL_VIRGIN_WINES=
CLIENTCELLAR_AFFILIATE_URL_SLURP=
CLIENTCELLAR_AFFILIATE_URL_HAY_WINES=
