# Optional. The app works without this.
OPENAI_API_KEY=

# Optional model used only to polish rule-based wording.
OPENAI_MODEL=gpt-4o-mini

# App URL for sitemap and Stripe redirect URLs.
APP_BASE_URL=http://localhost:8000

# Premium Pack payments are disabled unless all of these are set.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional Supabase Auth. Without these, login is disabled and all users are Free.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only. Used by Stripe fulfilment to update profile plan/status.
SUPABASE_SERVICE_ROLE_KEY=

# Optional MVP-only lead admin password.
ADMIN_PASSWORD=
